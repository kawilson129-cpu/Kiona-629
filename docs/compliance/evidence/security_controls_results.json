      "id": "C01-01",
      "control": "C-01",
      "scenario": "Every API route declares an identity/role dependency",
      "expected": "0 routes without an authorization dependency",
      "actual": "22 route(s) unprotected: GET /departments, GET /roles, GET /categories, GET /users, GET /policies, GET /policies/search, GET /policies/{policy_id}, POST /policies, POST /policies/{policy_id}/versions, POST /ask, GET /conversations/{conversation_id}, GET /clarifications, POST /clarifications, GET /clarifications/{request_id}, POST /clarifications/{request_id}/replies, POST /clarifications/{request_id}/resolve, GET /incident-categories, GET /incidents, POST /incidents, PATCH /incidents/{incident_id}, POST /feedback, GET /dashboard/policy-health",
      "status": "FAIL",
      "function": "test_c01_01_no_authorization_dependencies"
    },
    {
      "id": "C01-02",
      "control": "C-01",
      "scenario": "Auth foundation (auth.py) is imported and used by main.py",
      "expected": "main.py imports and enforces auth",
      "actual": "main.py has no import of auth.py; the verifier is unwired",
      "status": "FAIL",
      "function": "test_c01_02_auth_module_not_wired"
    },
