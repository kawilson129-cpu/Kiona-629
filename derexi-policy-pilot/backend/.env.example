# Copy this file to backend/.env and fill in your Supabase connection string.
# Never commit the real .env file (it is git-ignored).
#
# In Supabase: Project Settings -> Database -> Connection string.
# Use the "Session pooler" URI (IPv4-friendly) and replace [YOUR-PASSWORD]
# with your database password.
#
# Format:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

DATABASE_URL=postgresql://postgres.vnumvjamqtuxlctjdzoe:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Optional: AI agent for plain-English policy answers.
# Get a free Groq key at https://console.groq.com (no credit card; phone verify).
# Backend must be restarted after editing this file.
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=gpt-oss-120b   (or gpt-oss-20b for lighter/faster)
#
# Paid alternative (OpenAI platform):
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
#
# When OPENAI_API_KEY is unset (or on API error), /ask falls back to rule-based answers.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=gpt-oss-120b
