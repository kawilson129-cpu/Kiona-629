# Copy this file to backend/.env and fill in your Supabase connection string.
# Never commit the real .env file (it is git-ignored).
#
# In Supabase: Project Settings -> Database -> Connection string.
# Use the "Session pooler" URI (IPv4-friendly) and replace [YOUR-PASSWORD]
# with your database password.
#
# Format:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Remote development connections default to sslmode=require. Production requires
# sslmode=verify-full for certificate/hostname verification. For CA verification,
# append &sslmode=verify-full and point libpq at the Supabase CA bundle via
# PGSSLROOTCERT (the pooler certificate is not in the system trust store).

DATABASE_URL=postgresql://postgres.vnumvjamqtuxlctjdzoe:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Optional: AI agent for plain-English policy answers.
# Recommended: OpenRouter (one key, many models; https://openrouter.ai/keys).
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=openai/gpt-4o-mini   (or e.g. meta-llama/llama-3.3-70b-instruct)
#
# Free alternative (Groq tier): key at https://console.groq.com (no credit card; phone verify).
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=gpt-oss-120b   (or gpt-oss-20b for lighter/faster)
#
# Paid alternative (OpenAI platform):
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
#
# When OPENAI_API_KEY is unset (or on API error), /ask falls back to rule-based answers.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4o-mini

# Week 7 identity / messaging.
#
# Production uses Supabase JWTs. Set SUPABASE_URL (public, not a secret) so the
# backend can locate the project JWKS. Without it only the development identity
# provider can authenticate requests.
#
# The development persona provider mints short-lived tokens for seeded users.
# It is refused automatically when DEREXI_ENV=production. Keep DEREXI_DEV_AUTH
# unset in any deployed environment.
DEREXI_ENV=development
DEREXI_DEV_AUTH=0
# Optional allowlist of seeded user ids; blank means all seeded users.
# DEREXI_DEV_USER_IDS=8,4,2,6,9,12
#
# Public values only -- no secrets. The JWKS URL, issuer, and audience are all
# derived from SUPABASE_URL, so only SUPABASE_URL is required.
# SUPABASE_URL=https://vnumvjamqtuxlctjdzoe.supabase.co
# SUPABASE_JWKS_URL=https://vnumvjamqtuxlctjdzoe.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_ISS=https://vnumvjamqtuxlctjdzoe.supabase.co/auth/v1
# SUPABASE_JWT_AUD=authenticated
# SUPABASE_JWT_ALGS=ES256
# SUPABASE_JWT_LEEWAY=0
# SUPABASE_JWKS_TIMEOUT=5

# Optional private original-document retention. Use an existing private directory
# outside backend/static and the public docs site. Never commit original files.
# DEREXI_DOCUMENT_STORAGE_DIR=C:/private/derexi-documents

# Week 9 browser sessions (prepare configuration; no accounts are auto-created).
# Production requires an HTTPS origin and approved immutable Auth subject ->
# existing business-user id bindings. Role and department always come from DB.
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# DEREXI_PUBLIC_ORIGIN=https://derexi.example.com
# DEREXI_AUTH_SUBJECT_MAP={"approved-auth-subject-uuid":8}
# Keep real deployment configuration in ignored .env or the host secret store.
# Local persona testing: explicitly set DEREXI_ENV=development and DEREXI_DEV_AUTH=1.

# Incident support handoff: all optional and OFF/unconfigured by default.
# Registry, sender and SMTP credentials belong only in private configuration.
# Names: DEREXI_APPROVED_MAILBOXES, DEREXI_OUTBOUND_EMAIL, DEREXI_INCIDENT_AI
# Names: DEREXI_SMTP_HOST, DEREXI_SMTP_FROM, DEREXI_SMTP_USERNAME, DEREXI_SMTP_PASSWORD
# Live schema, destinations, AI export and outbound activation require review.
